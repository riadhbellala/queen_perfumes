# Supabase project URL and public anon key (Project Settings > API in the
# Supabase dashboard). Safe to expose client-side — access is governed by
# Row Level Security policies, not by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp Business number in international format, digits only, no "+" and
# no spaces (e.g. 213555000000).
NEXT_PUBLIC_WHATSAPP_NUMBER=
